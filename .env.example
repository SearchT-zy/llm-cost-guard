# ══════════════════════════════════════════════════════════════════════
# LLM-Cost-Guard 环境变量模板
# 复制为 .env 后按需修改。生成命令见 README。
# ══════════════════════════════════════════════════════════════════════

# ── 数据库 ──────────────────────────────────────────────────────────
# 本地开发（docker compose 只起 postgres 时）：localhost:5432
# docker compose 全容器部署时 app 容器内会自动覆盖为 postgres:5432
DATABASE_URL=postgresql://llmcg:change-me@localhost:5432/llmcg

# ── 安全（生产必填）────────────────────────────────────────────────
# 上游 API Key 的 AES-256-GCM 加密密钥，32 字节 base64。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ★更换此值将导致已保存的上游 Key 无法解密，请妥善保管。
ENCRYPTION_KEY=

# 管理后台登录密码；留空 = 不启用登录，仅允许本机（127.0.0.1）访问后台
ADMIN_PASSWORD=

# ── 汇率 ───────────────────────────────────────────────────────────
# USD→CNY 记账汇率快照（美元计价模型换算用；每条日志会落库当时值）
# [SAAS] 闭源增值占位：云端自动汇率源定时同步，开源内核只读此静态值
USD_CNY_RATE=7.20

# ── 未知模型兜底价（每百万 token）──────────────────────────────────
# 价格表中不存在的模型：开启兜底则按此价计费；关闭则只计 token 不计价（日志可见）
PRICING_FALLBACK_ENABLED=false
PRICING_FALLBACK_INPUT=1
PRICING_FALLBACK_OUTPUT=2
PRICING_FALLBACK_CURRENCY=CNY

# ── 网关 ───────────────────────────────────────────────────────────
# 上游总超时（毫秒，含流式全程）
UPSTREAM_TIMEOUT_MS=300000
# 后台会话有效期（小时）
SESSION_TTL_HOURS=12

# 无 usage 时的字符估算系数（误差说明见 src/lib/gateway/estimate.ts）
ESTIMATE_ASCII_PER_TOKEN=4
ESTIMATE_CJK_PER_TOKEN=1

# ── 突增异常启发式（朴素规则，说明见 src/lib/alerts/anomaly.ts）────
BURST_WINDOW_MINUTES=10
# 窗口消耗 ≥ 月预算的此比例 → 告警
BURST_BUDGET_RATIO=0.2
# 或窗口消耗 ≥ 过去 24h 窗口均值的此倍数 → 告警
BURST_MULTIPLIER=10
# 窗口消耗地板值（CNY），防小额高频误报
BURST_MIN_CNY=1

# ── 告警渠道（全部可选；一个都不配则告警事件仅入库记录）──────────
# 钉钉机器人 webhook（安全设置选"加签"），URL 与 SECRET 必须配对
ALERT_DINGTALK_WEBHOOK_URL=
ALERT_DINGTALK_SECRET=

# 飞书机器人 webhook（安全设置选"签名校验"），URL 与 SECRET 必须配对
ALERT_FEISHU_WEBHOOK_URL=
ALERT_FEISHU_SECRET=

# SMTP 邮件（QQ/163 邮箱用授权码）
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=llm-cost-guard@example.com
ALERT_SMTP_TO=
# [SAAS] 高级告警占位：多渠道聚合 / 升级 / 短信 / 企业微信 / 值班轮转（闭源，不实现）

# ── docker compose 专用（Postgres 容器密码）────────────────────────
POSTGRES_PASSWORD=change-me
